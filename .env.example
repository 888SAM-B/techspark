# ==========================================
# TechSpark / AI Skilling Pathfinder - Environment Template
# Copy this file to .env and fill in your actual credentials.
# ==========================================

# Google Gemini API Key (Required for AI features)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Backend Server Configuration
PORT=5000

# MongoDB Database Connection String
# For local MongoDB:
MONGO_URI=mongodb://localhost:27017/learnmate
# For MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_skilling?retryWrites=true&w=majority

# Frontend API Base URL (used by Vite frontend to connect to backend server)
VITE_API_BASE_URL=http://localhost:5000
